# Arweave Client Configuration
# Copy this file to .env and configure as needed

# =============================================================================
# Gateway Configuration
# =============================================================================

# Arweave gateway URL (default: https://arweave.net)
ARWEAVE_GATEWAY_URL=https://arweave.net

# Arweave GraphQL endpoint URL (default: https://arweave.net/graphql)
ARWEAVE_GRAPHQL_URL=https://arweave.net/graphql

# =============================================================================
# Request Configuration
# =============================================================================

# Request timeout in seconds (default: 30)
ARWEAVE_TIMEOUT_SECS=30

# Maximum retry count for failed requests (default: 3)
ARWEAVE_MAX_RETRIES=3

# Retry backoff in milliseconds (default: 1000)
# Actual backoff = ARWEAVE_RETRY_BACKOFF_MS * 2^retry_count
ARWEAVE_RETRY_BACKOFF_MS=1000

# =============================================================================
# Wallet Configuration
# =============================================================================

# Arweave wallet JWK JSON string (required for signing transactions)
# Example: {"kty":"RSA","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}
# WARNING: Keep this secret! Do not commit to version control.
ARWEAVE_WALLET_PATH=

# =============================================================================
# Testing Configuration
# =============================================================================

# Set to "true" to enable integration tests against live Arweave network
# WARNING: Integration tests may incur costs and require a funded wallet
ARWEAVE_INTEGRATION_TESTS=false
