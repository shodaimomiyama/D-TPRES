# D-TPRES AO Environment Configuration - MAINNET
# Generated by setup-local-ao.js

# Network Configuration
NETWORK=mainnet
PROTOCOL=ao
VARIANT=ao_0_1

# AO Network URLs
ARWEAVE_URL=https://arweave.net
GRAPHQL_URL=https://arweave.net/graphql
MU_URL=https://mu.ao.arweave.dev
SU_URL=https://su.ao.arweave.dev
CU_URL=https://cu.ao.arweave.dev

# Wallet Configuration
WALLET_PATH=./wallet.json

# Deployment Configuration
HOLDER_COUNT=3
THRESHOLD=2
TOTAL_SHARES=3
MODULE_PATH=./output/d_tpres.wasm

# Debug Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false
