# D-TPRES AO Environment Configuration - TESTNET
# Generated by setup-local-ao.js

# Network Configuration
NETWORK=testnet
PROTOCOL=ao
VARIANT=ao_0_1

# AO Network URLs
ARWEAVE_URL=https://arweave.net
GRAPHQL_URL=https://arweave.net/graphql
