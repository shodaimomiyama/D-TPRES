# D-TPRES AO Environment Configuration
# Copy this file to .env and configure for your environment

# Network Configuration (local | testnet | mainnet)
NETWORK=local
PROTOCOL=ao
VARIANT=ao_0_1

# AO Network URLs
ARWEAVE_URL=http://localhost:1984
GRAPHQL_URL=http://localhost:1984/graphql
MU_URL=http://localhost:1985
SU_URL=http://localhost:1986
CU_URL=http://localhost:1987

# Wallet Configuration
WALLET_PATH=./wallet.json

# Deployment Configuration
HOLDER_COUNT=3
THRESHOLD=2
TOTAL_SHARES=3
MODULE_PATH=./output/d_tpres.wasm

# Debug Configuration
DEBUG_MODE=true
VERBOSE_LOGGING=true

# Security Note:
# Never commit wallet files or private keys to version control
# Add wallet.json to .gitignore
